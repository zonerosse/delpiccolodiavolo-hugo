{{- /* _headers — generato da Hugo, unica fonte per le intestazioni HTTP.
     Non esiste piu' un static/_headers: due file finivano entrambi in
     public/_headers e si sovrascrivevano a vicenda.
     Cloudflare Pages applica al massimo 100 regole e scarta le altre in
     silenzio, quindi tenerle poche e' anche una garanzia. */ -}}
/*
  Vary: Accept
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

# NOTA SULLA CACHE. Nessun file di questo sito ha l'impronta nel nome
# (niente main.a3f9c2.css): un PDF sostituito si chiama come prima. Quindi
# niente "immutable" e niente cache di un anno, altrimenti chi ha gia'
# scaricato un referto se lo tiene finche' non scade, e il purge di
# Cloudflare non lo raggiunge: quello svuota l'edge, non i browser.
#
# I referti pesano poche decine di KB e vengono scaricati di rado: un
# giorno di cache non fa risparmiare nulla di misurabile e garantisce che
# una correzione si veda subito.
/docs/*
  Cache-Control: public, max-age=86400

# Sitemap, robots e i file per gli agenti AI: rigenerati a ogni build e
# letti da chi decide quanto spesso tornare. Devono essere sempre freschi.
# max-age=0 con must-revalidate non significa riscaricare ogni volta: il
# client chiede se e' cambiato e riceve un 304 quando non lo e'.
/*.xml
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/en/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/en/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/de/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/de/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=2592000

/*.js
  Cache-Control: public, max-age=2592000
