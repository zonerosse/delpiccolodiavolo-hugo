{{- /* _headers — generato da Hugo.
     Oltre alle regole statiche, dichiara per ogni pagina l'alternativa Markdown
     nell'intestazione HTTP Link, cosi' gli agenti la trovano senza scaricare l'HTML. */ -}}
/*
  Vary: Accept
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/docs/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Alternativa Markdown dichiarata nell'intestazione HTTP
{{ range .Site.AllPages }}{{ $p := . }}{{ with .OutputFormats.Get "MARKDOWN" }}{{ $p.RelPermalink }}
  Link: <{{ .Permalink }}>; rel="alternate"; type="text/markdown"
{{ end }}{{ end }}