{{- /* _headers — generato da Hugo, unica fonte per le intestazioni HTTP.
     Non esiste piu' un static/_headers: due file finivano entrambi in
     public/_headers e si sovrascrivevano a vicenda.
     Cloudflare Pages applica al massimo 100 regole e scarta le altre in
     silenzio, quindi tenerle poche e' anche una garanzia. */ -}}
/*
  Vary: Accept
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://gestionale.delpiccolodiavolo.it; font-src 'self'; media-src 'self'; connect-src 'self' https://gestionale.delpiccolodiavolo.it https://script.google.com https://script.googleusercontent.com https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; form-action 'self' https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# PROTEZIONI DEL BROWSER (ottobre 2026)
# Permissions-Policy: il sito non usa fotocamera, microfono, posizione,
# pagamenti, USB e MIDI; li vieta a se stesso e a ogni riquadro esterno.
# Content-Security-Policy = la "lista degli invitati": da dove il browser
# puo' caricare codice, immagini, riquadri e dati. ATTIVA dal 09/10/2026,
# dopo la prova in "-Report-Only" (Diario, Cuccioli, Palmares puliti).
# Per tornare in prova: rimettere "-Report-Only" nel nome dell'intestazione.
# Invitati (elenco ricavato dal codice del sito):
#   static.cloudflareinsights.com / cloudflareinsights.com  statistiche Cloudflare Web Analytics
#   gestionale.delpiccolodiavolo.it  cucciolate ed esposizioni (dati e foto), modulo contatto
#   script.google.com / script.googleusercontent.com  modulo /contatto/ (Apps Script)
#   www.youtube-nocookie.com  video del diario
# Un servizio esterno nuovo (mappa, video da un altro sito, statistiche...)
# va aggiunto qui, altrimenti con la lista attiva il browser lo blocca.
# 'unsafe-inline' resta perche' il sito usa molti script e stili scritti
# dentro le pagine (scelta voluta: niente file CSS esterni).

/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

# NOTA SULLA CACHE. Nessun file di questo sito ha l'impronta nel nome
# (niente main.a3f9c2.css): un PDF sostituito si chiama come prima. Quindi
# niente "immutable" e niente cache di un anno, altrimenti chi ha gia'
# scaricato un referto se lo tiene finche' non scade, e il purge di
# Cloudflare non lo raggiunge: quello svuota l'edge, non i browser.
#
# I PDF pesano da qualche decina di KB a poco piu' di 1 MB, ma vengono
# scaricati di rado: un giorno di cache non fa risparmiare nulla di
# misurabile e garantisce che una correzione si veda subito.
/docs/*
  Cache-Control: public, max-age=86400

# Sitemap, robots e i file per gli agenti AI: rigenerati a ogni build e
# letti da chi decide quanto spesso tornare. Devono essere sempre freschi.
# max-age=0 con must-revalidate non significa riscaricare ogni volta: il
# client chiede se e' cambiato e riceve un 304 quando non lo e'.
{{- with os.Getenv "CF_PAGES_COMMIT_SHA" }}
# Commit pubblicato: lo legge il workflow IndexNow per aspettare che la
# pubblicazione sia finita. Solo su Cloudflare; in locale la regola non c'e'.
/sitemap.xml
  X-Build: {{ . }}

{{ end -}}
/*.xml
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/en/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/en/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

/de/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/de/llms-full.txt
  Cache-Control: public, max-age=0, must-revalidate

# Indice delle pagine per il gestionale (Google -> Pagine del sito): lo legge solo il gestionale.
/pagine-indice.json
  Access-Control-Allow-Origin: https://gestionale.delpiccolodiavolo.it
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/robots.txt
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=2592000

/*.js
  Cache-Control: public, max-age=2592000
