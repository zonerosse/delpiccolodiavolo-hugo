#!/bin/sh
#
# pre-commit — aggiorna "lastmod" nelle pagine che stai committando.
#
# PERCHE' SERVE
# Cloudflare Pages clona il repository senza storia (un solo commit), quindi
# enableGitInfo non trova le date e Hugo scriverebbe 0001-01-01 nello schema.
# Tenere la data nel front matter risolve, ma va aggiornata: ci pensa questo.
#
# COSA FA
# Per ogni file .md sotto content/ incluso nel commit:
#   - se ha gia' "lastmod:", ne cambia il valore con la data di oggi
#   - se non ce l'ha, lo inserisce subito dopo la riga "title:"
# Poi rimette il file nell'area di staging, cosi' la modifica entra nel commit.
#
# NON tocca i file che non stai committando, ne' quelli fuori da content/.
#
# INSTALLAZIONE (una volta sola, in ogni copia del repository):
#   git config core.hooksPath .githooks
#
# Per saltarlo in un commit singolo:  git commit --no-verify

OGGI=$(date +%Y-%m-%d)
TOCCATI=0

# solo file aggiunti (A), modificati (M) o rinominati (R)
FILES=$(git diff --cached --name-only --diff-filter=AMR -- 'content/*.md' 'content/**/*.md')

[ -z "$FILES" ] && exit 0

TMP_A=$(mktemp); TMP_B=$(mktemp)
# Testo "visibile" di una versione del file: senza lastmod/date, senza tag
# HTML, con gli spazi compattati. Due versioni con lo stesso testo visibile
# sono la stessa pagina per chi legge, anche se il markup e' cambiato.
testo() {
  grep -v -e '^lastmod:' -e '^date:' | sed -e 's/<[^>]*>//g' -e 's/[[:space:]][[:space:]]*/ /g' -e '/^ *$/d'
}

for f in $FILES; do
  [ -f "$f" ] || continue

  # Se il file esisteva gia' e il testo visibile non e' cambiato (solo
  # markup, classi, attributi, link interni o la data di pubblicazione),
  # lastmod resta com'e': la sitemap deve dire che una pagina e' cambiata
  # solo quando e' cambiata davvero per chi la legge.
  if git cat-file -e "HEAD:$f" 2>/dev/null; then
    git show "HEAD:$f" | testo > "$TMP_A"
    git show ":$f" | testo > "$TMP_B"
    if cmp -s "$TMP_A" "$TMP_B"; then
      continue
    fi
  fi

  if grep -q '^lastmod:' "$f"; then
    # esiste: sostituisco il valore, ma solo se e' diverso da oggi
    if grep -q "^lastmod: $OGGI\$" "$f"; then
      continue
    fi
    sed -i "0,/^lastmod:.*/s//lastmod: $OGGI/" "$f"
  else
    # non esiste: lo inserisco dopo il titolo
    if grep -q '^title:' "$f"; then
      sed -i "0,/^title:.*/s//&\\nlastmod: $OGGI/" "$f"
    else
      # nessun titolo: lo metto in cima al front matter
      sed -i "0,/^---\$/s//---\\nlastmod: $OGGI/" "$f"
    fi
  fi

  git add "$f"
  TOCCATI=$((TOCCATI + 1))
done

rm -f "$TMP_A" "$TMP_B"

if [ "$TOCCATI" -gt 0 ]; then
  echo "lastmod aggiornato a $OGGI in $TOCCATI file (solo quelli con testo cambiato)"
fi

# ---------------------------------------------------------------------------
# Secondo controllo: la data di PUBBLICAZIONE.
#
# PERCHE' SERVE
# Con enableGitInfo attivo, un articolo senza "date:" nel front matter eredita
# la data dell'ultimo commit: basta correggere una virgola e quell'articolo
# risulta pubblicato oggi, finendo in cima a "Ultimi articoli". La sezione
# [frontmatter] in hugo.toml lo impedisce, ma se un giorno quella sezione
# sparisse il problema tornerebbe in silenzio. Questo controllo lo intercetta.
#
# COSA FA
# Blocca il commit se un file con "articolo: true" non ha "date:".
# ---------------------------------------------------------------------------
MANCANTI=""
for f in $(git diff --cached --name-only --diff-filter=ACM | grep '^content/.*\.md$'); do
  [ -f "$f" ] || continue
  grep -q '^articolo: true' "$f" || continue
  grep -q '^date:' "$f" && continue
  MANCANTI="$MANCANTI  $f\n"
done

if [ -n "$MANCANTI" ]; then
  echo ""
  echo "COMMIT FERMATO: questi articoli non hanno la data di pubblicazione."
  printf "$MANCANTI"
  echo ""
  echo "Aggiungi nel front matter la data vera, per esempio:"
  echo "  date: $OGGI"
  echo ""
  echo "Senza, Hugo usa la data dell'ultimo commit e l'articolo risulta di oggi."
  exit 1
fi

exit 0
